// Giao diện Lenovo Toolkit (Rust/Slint) — thiết kế tinh gọn, hiện đại:
// - Trang Home (Dashboard): Bảng chỉ số gộp gọn trên đầu (chỉ giữ thông số thật CPU/GPU/System),
//   bên dưới là 1 cột dọc từ trên xuống: Power -> Display -> Other (không cắt chữ).
// - Trang Battery: Đầy đủ thông tin từ driver pin Windows + Lenovo EnergyDrv như mã nguồn gốc.
// - Trang Settings: Căn đỉnh chuẩn, hỗ trợ System Tray & đầy đủ Software Control.

global Palette {
    out property <color> window-bg: #18191c;
    out property <color> panel-bg: #202226;
    out property <color> card-bg: #2a2d33;
    out property <color> card-border: #363a42;
    out property <color> control-bg: #363a42;
    out property <color> control-hover: #434852;
    out property <color> divider: #383c45;
    out property <color> text: #f3f4f6;
    out property <color> subtext: #aeb4c0;
    out property <color> accent: #4cc2ff;
    out property <color> warn: #ffb74d;
    out property <color> bar-track: #3b4049;
    out property <color> bar-fill: #38bdf8;
}

// kind: 0 = danh sách chọn, 1 = công tắc, 2 = danh sách chọn + nút bánh răng (AI Engine / Custom Mode)
export struct Item { id: string, icon: string, title: string, message: string, hint: string, kind: int, options: [string], value: string, on: bool }
export struct SensorRow { label: string, value: string, fraction: float }
export struct SectionData { title: string, subtitle: string, rows: [SensorRow] }
export struct InfoRow { title: string, message: string, value: string }
export struct TuneRow { id: int, title: string, description: string, warning: string, value-text: string, can-dec: bool, can-inc: bool, changed: bool }
export struct SubItem { title: string, right: string, sub: string }
export struct DriveItem { title: string, usage: string, model: string, fraction: float }
export struct DeviceInfoData {
    header: string,
    os: string,
    serial: string,
    serial-masked: string,
    model: string,
    mtm: string,
    bios: string,
    series: string,
    generation: string,
    power-modes: string,
    capabilities: string,
    cpu-name: string,
    cpu-sub: string,
    gpus: [SubItem],
    rams: [SubItem],
    mb-name: string,
    mb-vendor: string,
    drives: [DriveItem],
    displays: [SubItem],
    bat-charge: string,
    bat-health: string,
    bat-health-frac: float,
    bat-design: string,
    bat-full: string,
    bat-cycles: string,
    bat-date: string,
    nets: [SubItem],
}

component Icon inherits Text {
    in property <string> glyph;
    text: glyph;
    font-family: "Segoe Fluent Icons";
    horizontal-alignment: center;
    vertical-alignment: center;
}

/// Tab điều hướng chỉ có icon (nằm ngang ở thanh trên); `label` chỉ dành cho trình đọc màn hình.
component IconTab inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    width: 42px;
    height: 34px;
    border-radius: 8px;
    background: selected ? #2c3038 : (ta.has-hover ? #24272d : transparent);
    accessible-role: button;
    accessible-label: root.label;

    Icon { glyph: root.glyph; font-size: 18px; color: root.selected ? Palette.accent : Palette.text; }
    if selected : Rectangle {
        x: (root.width - 16px) / 2;
        y: root.height - 4px;
        width: 16px;
        height: 3px;
        border-radius: 2px;
        background: Palette.accent;
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 44px;
    height: 22px;
    border-radius: 11px;
    opacity: root.enabled ? 1.0 : 0.4;
    background: root.checked ? Palette.accent : #262930;
    border-width: root.checked ? 0px : 1px;
    border-color: #8a909e;

    Rectangle {
        width: 14px;
        height: 14px;
        border-radius: 7px;
        y: 4px;
        x: root.checked ? 26px : 4px;
        background: root.checked ? #0f172a : #d1d5db;
        animate x { duration: 120ms; }
    }
    TouchArea { enabled: root.enabled; clicked => { root.toggled(!root.checked); } }
}

component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <string> value;
    callback selected(string);

    min-width: 176px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.card-border;
    background: ta.has-hover ? Palette.control-hover : Palette.control-bg;

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 10px;
        spacing: 8px;
        Text { text: root.value; color: Palette.text; font-size: 13px; font-weight: 500; vertical-alignment: center; horizontal-stretch: 1; }
        Icon { glyph: "\u{E70D}"; font-size: 11px; color: Palette.subtext; width: 14px; }
    }
    ta := TouchArea { clicked => { popup.show(); } }

    popup := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: root.width;
        Rectangle {
            background: #2b2e35;
            border-radius: 6px;
            border-width: 1px;
            border-color: Palette.divider;
            VerticalLayout {
                padding: 4px;
                for o in root.options : Rectangle {
                    height: 34px;
                    border-radius: 4px;
                    background: t.has-hover ? Palette.control-hover : transparent;
                    Text { x: 12px; text: o; color: Palette.text; font-size: 13px; vertical-alignment: center; }
                    t := TouchArea { clicked => { root.selected(o); } }
                }
            }
        }
    }
}

component GearButton inherits Rectangle {
    callback clicked;
    width: 36px;
    height: 34px;
    border-radius: 6px;
    border-width: 1px;
    border-color: Palette.card-border;
    background: ta.has-hover ? Palette.control-hover : Palette.control-bg;
    Icon { glyph: "\u{E713}"; font-size: 15px; color: Palette.text; }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SettingCard inherits Rectangle {
    in property <string> glyph;
    in property <string> title;
    in property <string> message;
    in property <string> hint;

    min-height: layout.preferred-height;
    background: Palette.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.card-border;

    layout := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        Icon { glyph: root.glyph; font-size: 20px; color: Palette.accent; width: 26px; }
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.title; color: Palette.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
            if root.message != "" : Text { text: root.message; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }
            if root.hint != "" : HorizontalLayout {
                spacing: 6px;
                padding-top: 3px;
                Icon { glyph: "\u{E946}"; font-size: 12px; color: Palette.accent; width: 14px; }
                Text { text: root.hint; color: Palette.accent; font-size: 12px; wrap: word-wrap; horizontal-stretch: 1; }
            }
        }
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

component Group inherits VerticalLayout {
    in property <string> title;
    in property <[Item]> items;
    callback combo(string, string);
    callback toggle(string, bool);
    callback gear();

    spacing: 8px;
    alignment: start;

    if root.items.length > 0 && root.title != "" : Text {
        text: root.title;
        color: Palette.text;
        font-size: 17px;
        font-weight: 600;
    }
    for item in root.items : SettingCard {
        glyph: item.icon;
        title: item.title;
        message: item.message;
        hint: item.hint;
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            if item.kind == 2 : GearButton { clicked => { root.gear(); } }
            if item.kind != 1 : Dropdown {
                options: item.options;
                value: item.value;
                selected(v) => { root.combo(item.id, v); }
            }
            if item.kind == 1 : Toggle {
                checked: item.on;
                toggled(on) => { root.toggle(item.id, on); }
            }
        }
    }
}

component SensorLine inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <float> fraction;
    spacing: 10px;
    height: 22px;
    Text { text: root.label; color: Palette.subtext; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
    Text { text: root.value; color: Palette.text; font-size: 12px; font-weight: 600; horizontal-alignment: right; vertical-alignment: center; }
    if root.fraction >= 0 : VerticalLayout {
        width: 54px;
        alignment: center;
        Rectangle {
            height: 5px;
            border-radius: 2.5px;
            background: Palette.bar-track;
            Rectangle {
                x: 0px;
                width: parent.width * (root.fraction < 0 ? 0 : (root.fraction > 1 ? 1 : root.fraction));
                height: parent.height;
                border-radius: 2.5px;
                background: Palette.bar-fill;
            }
        }
    }
}

component SensorSection inherits VerticalLayout {
    in property <SectionData> data;
    spacing: 6px;
    alignment: start;
    HorizontalLayout {
        spacing: 8px;
        Text { text: root.data.title; color: Palette.accent; font-size: 14px; font-weight: 700; vertical-alignment: center; }
        Text { text: root.data.subtitle; color: Palette.subtext; font-size: 11px; horizontal-alignment: right; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    Rectangle { height: 1px; background: Palette.divider; }
    for r in root.data.rows : SensorLine { label: r.label; value: r.value; fraction: r.fraction; }
}

// Khối cảm biến gộp chung trên đầu trang Home (3 cột gọn trong 1 bảng duy nhất)
component UnifiedSensorBar inherits Rectangle {
    in property <[SectionData]> sections;
    background: Palette.card-bg;
    border-radius: 10px;
    border-width: 1px;
    border-color: Palette.card-border;

    HorizontalLayout {
        padding: 14px;
        spacing: 18px;
        for s[i] in root.sections : HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 18px;
            if i > 0 : Rectangle { width: 1px; background: Palette.divider; }
            SensorSection {
                horizontal-stretch: 1;
                data: s;
            }
        }
    }
}

component DashboardPage inherits Flickable {
    in property <bool> vi;
    // Thông báo thiết bị chưa được hỗ trợ (ITS); rỗng với máy Legion/LOQ.
    in property <string> notice;
    in property <[SectionData]> sensor-sections;
    in property <[Item]> power-items;
    in property <[Item]> graphics-items;
    in property <[Item]> display-items;
    in property <[Item]> other-items;
    callback combo(string, string);
    callback toggle(string, bool);
    callback gear();

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: 18px;
        spacing: 16px;
        alignment: start;

        // 0. Cảnh báo thiết bị không thuộc nhóm gaming: điều khiển ghi phần cứng được ẩn
        if root.notice != "" : Rectangle {
            background: #4a3a1a;
            border-radius: 8px;
            HorizontalLayout {
                padding: 12px;
                Text { text: root.notice; color: #ffb74d; font-size: 13px; wrap: word-wrap; }
            }
        }

        // 1. Khối chỉ số hệ thống gộp chung gọn gàng trên đầu
        if root.sensor-sections.length > 0 : UnifiedSensorBar {
            sections: root.sensor-sections;
        }

        // 2. Nhóm Power ở trên
        Group {
            title: root.vi ? "Nguồn điện & Hiệu năng" : "Power";
            items: root.power-items;
            combo(i, v) => { root.combo(i, v); }
            toggle(i, o) => { root.toggle(i, o); }
            gear => { root.gear(); }
        }

        // 3. Nhóm Graphics (nếu máy hỗ trợ)
        if root.graphics-items.length > 0 : Group {
            title: root.vi ? "Đồ họa" : "Graphics";
            items: root.graphics-items;
            combo(i, v) => { root.combo(i, v); }
            toggle(i, o) => { root.toggle(i, o); }
            gear => { root.gear(); }
        }

        // 4. Nhóm Display (nếu máy hỗ trợ)
        if root.display-items.length > 0 : Group {
            title: root.vi ? "Màn hình" : "Display";
            items: root.display-items;
            combo(i, v) => { root.combo(i, v); }
            toggle(i, o) => { root.toggle(i, o); }
            gear => { root.gear(); }
        }

        // 5. Nhóm Other đi xuống nằm dưới Power/Graphics/Display
        if root.other-items.length > 0 : Group {
            title: root.vi ? "Khác" : "Other";
            items: root.other-items;
            combo(i, v) => { root.combo(i, v); }
            toggle(i, o) => { root.toggle(i, o); }
            gear => { root.gear(); }
        }
    }
}

component BatteryPage inherits Flickable {
    in property <bool> vi;
    in property <string> percent-text;
    in property <string> status-text;
    in property <string> warning-text;
    in property <[InfoRow]> rows;

    content-height: content.preferred-height;

    content := VerticalLayout {
        padding: 20px;
        spacing: 14px;
        alignment: start;

        Text { text: root.vi ? "Thông tin Pin" : "Battery"; color: Palette.text; font-size: 24px; font-weight: 700; }

        Rectangle {
            background: Palette.card-bg;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.card-border;
            HorizontalLayout {
                padding: 18px;
                spacing: 22px;
                Icon { glyph: "\u{E83F}"; font-size: 56px; color: Palette.accent; width: 72px; }
                VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    horizontal-stretch: 1;
                    Text { text: root.percent-text; color: Palette.text; font-size: 32px; font-weight: 700; }
                    Text { text: root.status-text; color: Palette.subtext; font-size: 15px; }
                    if root.warning-text != "" : Text { text: root.warning-text; color: Palette.warn; font-size: 13px; font-weight: 600; }
                }
            }
        }

        for r in root.rows : Rectangle {
            min-height: 62px;
            background: Palette.card-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.card-border;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 10px;
                padding-bottom: 10px;
                spacing: 16px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 2px;
                    Text { text: r.title; color: Palette.text; font-size: 14px; font-weight: 600; }
                    Text { text: r.message; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }
                }
                Text { text: r.value; color: Palette.text; font-size: 15px; font-weight: 600; vertical-alignment: center; horizontal-alignment: right; }
            }
        }
    }
}

component StepButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked;

    width: 34px;
    height: 34px;
    border-radius: 6px;
    opacity: root.enabled ? 1.0 : 0.35;
    background: ta.has-hover && root.enabled ? Palette.control-hover : Palette.control-bg;
    Text { text: root.glyph; color: Palette.text; font-size: 18px; horizontal-alignment: center; vertical-alignment: center; }
    ta := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

component ActionButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary;
    callback clicked;

    height: 36px;
    min-width: 110px;
    border-radius: 6px;
    background: root.primary ? (ta.has-hover ? #6bd0ff : Palette.accent) : (ta.has-hover ? Palette.control-hover : Palette.control-bg);
    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        Text { text: root.label; color: root.primary ? #0f172a : Palette.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component TuneRowView inherits Rectangle {
    in property <TuneRow> data;
    in property <bool> locked;
    callback step(int);

    background: Palette.card-bg;
    border-radius: 8px;
    border-width: 1px;
    border-color: Palette.card-border;
    HorizontalLayout {
        padding: 14px;
        spacing: 14px;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 3px;
            alignment: center;
            Text { text: root.data.title; color: Palette.text; font-size: 14px; font-weight: 600; wrap: word-wrap; }
            Text { text: root.data.description; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }
            if root.data.changed && !root.locked && root.data.warning != "" : Text {
                text: root.data.warning;
                color: Palette.warn;
                font-size: 12px;
                wrap: word-wrap;
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            VerticalLayout { alignment: center; StepButton { glyph: "−"; enabled: !root.locked && root.data.can-dec; clicked => { root.step(-1); } } }
            Text {
                text: root.data.value-text;
                min-width: 78px;
                color: root.locked ? Palette.subtext : Palette.text;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            VerticalLayout { alignment: center; StepButton { glyph: "+"; enabled: !root.locked && root.data.can-inc; clicked => { root.step(1); } } }
        }
    }
}

component SubNavItem inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> selected;
    callback clicked;

    height: 44px;
    border-radius: 6px;
    background: selected ? Palette.card-bg : (ta.has-hover ? #262930 : transparent);

    if selected : Rectangle { x: 2px; y: 12px; width: 3px; height: 20px; border-radius: 2px; background: Palette.accent; }
    HorizontalLayout {
        padding-left: 16px;
        spacing: 12px;
        Icon { glyph: root.glyph; font-size: 15px; color: root.selected ? Palette.accent : Palette.text; width: 20px; }
        Text { text: root.label; color: Palette.text; font-size: 14px; font-weight: root.selected ? 600 : 400; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } }
}

component SettingsPage inherits Rectangle {
    in property <bool> vi;
    in-out property <int> section: 0;
    in property <[Item]> app-items;
    in property <[Item]> power-items;
    in property <[Item]> smartkey-items;
    in property <[Item]> software-items;
    in property <[Item]> notify-items;
    callback combo(string, string);
    callback toggle(string, bool);

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;

        Text {
            text: root.vi ? "Cài đặt" : "Settings";
            color: Palette.text;
            font-size: 24px;
            font-weight: 700;
            vertical-stretch: 0;
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 20px;
            VerticalLayout {
                width: 220px;
                spacing: 6px;
                alignment: start;
                SubNavItem { glyph: "\u{E8A1}"; label: root.vi ? "Hành vi ứng dụng" : "App Behavior"; selected: root.section == 0; clicked => { root.section = 0; } }
                SubNavItem { glyph: "\u{E83E}"; label: root.vi ? "Nguồn điện" : "Power"; selected: root.section == 1; clicked => { root.section = 1; } }
                SubNavItem { glyph: "\u{E765}"; label: root.vi ? "Phím tắt (Smart Keys)" : "Smart Keys"; selected: root.section == 2; clicked => { root.section = 2; } }
                SubNavItem { glyph: "\u{EA18}"; label: root.vi ? "Kiểm soát phần mềm" : "Software Control"; selected: root.section == 3; clicked => { root.section = 3; } }
                SubNavItem { glyph: "\u{EA8F}"; label: root.vi ? "Thông báo" : "Notifications"; selected: root.section == 4; clicked => { root.section = 4; } }
            }
            Flickable {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                content-height: body.preferred-height;
                body := VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    if root.section == 0 : Group {
                        title: "";
                        items: root.app-items;
                        combo(i, v) => { root.combo(i, v); }
                        toggle(i, o) => { root.toggle(i, o); }
                    }
                    if root.section == 1 : Group {
                        title: "";
                        items: root.power-items;
                        combo(i, v) => { root.combo(i, v); }
                        toggle(i, o) => { root.toggle(i, o); }
                    }
                    if root.section == 2 : Group {
                        title: "";
                        items: root.smartkey-items;
                        combo(i, v) => { root.combo(i, v); }
                        toggle(i, o) => { root.toggle(i, o); }
                    }
                    if root.section == 3 : Group {
                        title: "";
                        items: root.software-items;
                        combo(i, v) => { root.combo(i, v); }
                        toggle(i, o) => { root.toggle(i, o); }
                    }
                    if root.section == 4 : Group {
                        title: "";
                        items: root.notify-items;
                        combo(i, v) => { root.combo(i, v); }
                        toggle(i, o) => { root.toggle(i, o); }
                    }
                }
            }
        }
    }
}

export component AppWindow inherits Window {
    in property <string> app-title: "Lenovo Toolkit";
    title: root.app-title;
    icon: @image-url("icon.png");
    preferred-width: 980px;
    preferred-height: 720px;
    min-width: 780px;
    min-height: 540px;
    background: Palette.window-bg;

    in-out property <int> page: 0;
    in property <bool> vi: false;
    in property <string> model-name;
    in property <string> status;
    in property <string> device-notice;
    in property <bool> ai-enabled;

    in property <[SectionData]> sensor-sections;
    in property <[Item]> power-items;
    in property <[Item]> graphics-items;
    in property <[Item]> display-items;
    in property <[Item]> other-items;

    in property <[Item]> settings-app-items;
    in property <[Item]> settings-power-items;
    in property <[Item]> settings-smartkey-items;
    in property <[Item]> settings-software-items;
    in property <[Item]> settings-notify-items;

    in property <string> battery-percent;
    in property <string> battery-status;
    in property <string> battery-warning;
    in property <[InfoRow]> battery-rows;

    // Cửa sổ Custom Mode Settings
    in property <[TuneRow]> custom-rows;
    in property <bool> custom-locked: true;
    in property <string> custom-active;
    in property <bool> custom-fan-on;
    in property <string> custom-note;

    // Cửa sổ Về thiết bị của bạn (Device Information)
    in property <DeviceInfoData> device-info;
    in-out property <bool> show-serial: false;

    callback page-changed(int);
    callback combo(string, string);
    callback toggle(string, bool);
    callback set-ai(bool);
    callback custom-select(string);
    callback custom-tune(int, int);
    callback custom-fan(bool);
    callback custom-apply();
    callback custom-reset();
    callback custom-open();
    callback device-info-open();

    VerticalLayout {
        // Thanh trên: icon điều hướng (không chữ) bên trái, trạng thái ở giữa, nút ẩn xuống Tray + tên máy + Cài đặt ở cuối.
        HorizontalLayout {
            height: 48px;
            padding-left: 10px;
            padding-right: 10px;
            spacing: 6px;
            VerticalLayout {
                alignment: center;
                IconTab { glyph: "\u{E80F}"; label: root.vi ? "Trang chủ" : "Dashboard"; selected: root.page == 0; clicked => { root.page = 0; root.page-changed(0); } }
            }
            VerticalLayout {
                alignment: center;
                IconTab { glyph: "\u{E83F}"; label: root.vi ? "Pin" : "Battery"; selected: root.page == 1; clicked => { root.page = 1; root.page-changed(1); } }
            }
            Text { text: root.status; color: Palette.subtext; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
            VerticalLayout {
                alignment: center;
                Rectangle {
                    height: 28px;
                    width: chip.preferred-width + 24px;
                    border-radius: 5px;
                    background: chip-ta.has-hover ? Palette.control-hover : Palette.card-bg;
                    border-width: 1px;
                    border-color: Palette.card-border;
                    chip := Text { text: root.model-name; color: Palette.text; font-size: 13px; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                    chip-ta := TouchArea {
                        clicked => {
                            root.show-serial = false;
                            root.device-info-open();
                            device-info-popup.show();
                        }
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                IconTab { glyph: "\u{E713}"; label: root.vi ? "Cài đặt" : "Settings"; selected: root.page == 2; clicked => { root.page = 2; root.page-changed(2); } }
            }
        }

            Rectangle {
                horizontal-stretch: 1;
                vertical-stretch: 1;
                background: Palette.panel-bg;

                if root.page == 0 : DashboardPage {
                    vi: root.vi;
                    notice: root.device-notice;
                    sensor-sections: root.sensor-sections;
                    power-items: root.power-items;
                    graphics-items: root.graphics-items;
                    display-items: root.display-items;
                    other-items: root.other-items;
                    combo(i, v) => { root.combo(i, v); }
                    toggle(i, o) => { root.toggle(i, o); }
                    gear => {
                        if root.power-items[0].value == "Custom" || root.power-items[0].value == "Tùy chỉnh (Custom)" {
                            root.custom-open();
                            custom-popup.show();
                        } else {
                            ai-popup.show();
                        }
                    }
                }
                if root.page == 1 : BatteryPage {
                    vi: root.vi;
                    percent-text: root.battery-percent;
                    status-text: root.battery-status;
                    warning-text: root.battery-warning;
                    rows: root.battery-rows;
                }
                if root.page == 2 : SettingsPage {
                    vi: root.vi;
                    app-items: root.settings-app-items;
                    power-items: root.settings-power-items;
                    smartkey-items: root.settings-smartkey-items;
                    software-items: root.settings-software-items;
                    notify-items: root.settings-notify-items;
                    combo(i, v) => { root.combo(i, v); }
                    toggle(i, o) => { root.toggle(i, o); }
                }
            }
    }

    custom-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - 680px) / 2;
        y: 24px;
        width: 680px;
        height: root.height - 48px;

        Rectangle {
            background: #24272d;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.divider;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    Text { text: root.vi ? "Cài đặt chế độ Tùy chỉnh (Custom Mode)" : "Custom Mode Settings"; color: Palette.text; font-size: 18px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                    ActionButton { label: root.vi ? "Đóng" : "Done"; clicked => { custom-popup.close(); } }
                }

                Rectangle {
                    background: root.custom-locked ? #1f3a2a : #4a3a1a;
                    border-radius: 6px;
                    HorizontalLayout {
                        padding: 12px;
                        Text {
                            text: root.custom-locked
                                ? (root.vi ? "Đây là thông số xuất xưởng mặc định của Lenovo cho chế độ Custom (đã khóa). Chọn Custom nếu muốn tự chỉnh." : "These are Lenovo's factory values for Custom mode. They are locked. Select Custom to change them.")
                                : (root.vi ? "Chế độ Custom cho phép can thiệp giới hạn điện năng và quạt. Chỉnh sai có thể gây mất ổn định hoặc quá nhiệt." : "Custom Mode grants access to critical system parameters such as power limits and fan curves. Misconfiguration can lead to severe system instability, thermal throttling, or permanent hardware damage. Modifications made here may void your manufacturer warranty.");
                            color: root.custom-locked ? #7be0a0 : Palette.warn;
                            font-size: 12px;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    ActionButton { label: root.vi ? "Mặc định Lenovo (khuyên dùng)" : "Lenovo default (recommended)"; primary: root.custom-locked; clicked => { root.custom-select("Lenovo default (recommended)"); } }
                    ActionButton { label: root.vi ? "Tùy chỉnh (Custom)" : "Custom"; primary: !root.custom-locked; clicked => { root.custom-select("Custom"); } }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-height: list.preferred-height;
                    list := VerticalLayout {
                        spacing: 8px;
                        alignment: start;
                        for r in root.custom-rows : TuneRowView {
                            data: r;
                            locked: root.custom-locked;
                            step(dir) => { root.custom-tune(r.id, dir); }
                        }
                        Rectangle {
                            background: Palette.card-bg;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Palette.card-border;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 14px;
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 3px;
                                    Text { text: root.vi ? "Tốc độ quạt tối đa (100%)" : "Maximum fan speed"; color: Palette.text; font-size: 14px; font-weight: 600; }
                                    Text { text: root.vi ? "Bỏ qua biểu đồ nhiệt và ép cả hai quạt chạy liên tục ở tốc độ tối đa." : "Bypass all sensor-based fan curves and force both fans to run continuously at their maximum rated RPM."; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }
                                    Text { text: root.vi ? "Chạy 100% trong thời gian dài gây ồn và giảm tuổi thọ quạt." : "Prolonged operation at maximum speed increases fan wear and acoustic noise. Do not leave the fans at 100% for long periods."; color: Palette.warn; font-size: 12px; wrap: word-wrap; }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    Toggle { checked: root.custom-fan-on; enabled: !root.custom-locked; toggled(on) => { root.custom-fan(on); } }
                                }
                            }
                        }
                    }
                }

                if root.custom-note != "" : Text { text: root.custom-note; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;
                    ActionButton { label: root.vi ? "Khôi phục mặc định Lenovo" : "Reset to Lenovo default"; clicked => { root.custom-reset(); } }
                    ActionButton { label: root.vi ? "Áp dụng" : "Apply"; primary: true; clicked => { root.custom-apply(); } }
                }
            }
        }
    }

    ai-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: (root.width - 380px) / 2;
        y: 140px;
        width: 380px;
        Rectangle {
            background: #2b2e35;
            border-radius: 8px;
            border-width: 1px;
            border-color: Palette.divider;
            VerticalLayout {
                padding: 20px;
                spacing: 14px;
                Text { text: root.vi ? "Cài đặt chế độ Cân bằng (Balance)" : "Balance mode settings"; color: Palette.text; font-size: 17px; font-weight: 600; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: "AI Engine"; color: Palette.text; font-size: 14px; vertical-alignment: center; horizontal-stretch: 1; }
                    Toggle { checked: root.ai-enabled; toggled(on) => { root.set-ai(on); } }
                }
                Text {
                    text: root.vi ? "Khi bật, firmware tự động tối ưu công suất khi đang cắm sạc, ở chế độ Balance và có game đang chạy." : "When enabled, the firmware tunes performance while plugged in, in Balance mode, and a game is running.";
                    color: Palette.subtext;
                    font-size: 12px;
                    wrap: word-wrap;
                }
            }
        }
    }

    device-info-popup := PopupWindow {
        close-policy: close-on-click-outside;
        x: 24px;
        y: 20px;
        width: root.width - 48px;
        height: root.height - 40px;

        Rectangle {
            background: #202226;
            border-radius: 10px;
            border-width: 1px;
            border-color: Palette.divider;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                // Thanh tiêu đề cố định trên cùng
                HorizontalLayout {
                    spacing: 10px;
                    Icon { glyph: "\u{E7F8}"; font-size: 18px; color: Palette.accent; width: 22px; }
                    Text {
                        text: root.vi ? "Về thiết bị của bạn" : "About your device";
                        color: Palette.text;
                        font-size: 18px;
                        font-weight: 700;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    ActionButton { label: root.vi ? "Đóng" : "Close"; clicked => { device-info-popup.close(); } }
                }

                Rectangle {
                    clip: true;
                    vertical-stretch: 1;
                    Flickable {
                        width: 100%;
                        height: 100%;
                        content-height: info-body.preferred-height;

                        info-body := VerticalLayout {
                        spacing: 12px;
                        alignment: start;

                        // 1. Thanh định danh thiết bị trải ngang trên đầu (Device Identity Banner)
                        Rectangle {
                            background: Palette.card-bg;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Palette.card-border;
                            HorizontalLayout {
                                padding: 14px;
                                spacing: 18px;

                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    spacing: 4px;
                                    alignment: center;
                                    Text { text: root.device-info.header; color: Palette.accent; font-size: 16px; font-weight: 700; }
                                    Text {
                                        text: root.device-info.os
                                            + (root.device-info.series != "" ? "  ·  " + root.device-info.series : "")
                                            + (root.device-info.generation != "" ? " (" + root.device-info.generation + ")" : "");
                                        color: Palette.subtext;
                                        font-size: 12px;
                                    }
                                }

                                Rectangle { width: 1px; background: Palette.divider; }

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: root.vi ? "Mẫu (Model)" : "Model"; color: Palette.subtext; font-size: 11px; }
                                    Text { text: root.device-info.model; color: Palette.text; font-size: 13px; font-weight: 600; }
                                }

                                Rectangle { width: 1px; background: Palette.divider; }

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: root.vi ? "Loại máy (MTM)" : "Machine Type"; color: Palette.subtext; font-size: 11px; }
                                    Text { text: root.device-info.mtm; color: Palette.text; font-size: 13px; font-weight: 600; }
                                }

                                Rectangle { width: 1px; background: Palette.divider; }

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: "BIOS"; color: Palette.subtext; font-size: 11px; }
                                    Text { text: root.device-info.bios; color: Palette.text; font-size: 13px; font-weight: 600; }
                                }

                                Rectangle { width: 1px; background: Palette.divider; }

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;
                                    Text { text: root.vi ? "Số sê-ri (S/N)" : "Serial Number"; color: Palette.subtext; font-size: 11px; }
                                    HorizontalLayout {
                                        spacing: 8px;
                                        Text {
                                            text: root.show-serial ? root.device-info.serial : root.device-info.serial-masked;
                                            color: Palette.text;
                                            font-size: 13px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Rectangle {
                                            width: 24px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: sn-ta.has-hover ? Palette.control-hover : Palette.control-bg;
                                            Icon { glyph: "\u{E7B3}"; font-size: 12px; color: Palette.text; }
                                            sn-ta := TouchArea { clicked => { root.show-serial = !root.show-serial; } }
                                        }
                                    }
                                }
                            }
                        }

                        // 2. Bố cục 2 cột chia đôi 50% / 50% cân đối tuyệt đối
                        HorizontalLayout {
                            spacing: 12px;
                            alignment: stretch;

                            // Cột Trái (50%): Vi xử lý & Bo mạch, Đồ họa & Màn hình, Bộ nhớ RAM, Nền tảng & Tính năng
                            VerticalLayout {
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                spacing: 12px;
                                alignment: start;

                                // Thẻ CPU & Bo mạch chủ
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E950}"; font-size: 15px; color: Palette.accent; width: 18px; }
                                            Text { text: root.vi ? "Vi xử lý & Bo mạch chủ" : "Processor & Motherboard"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: root.device-info.cpu-name; color: Palette.text; font-size: 13px; font-weight: 600; horizontal-stretch: 1; overflow: elide; }
                                            Text { text: root.device-info.cpu-sub; color: Palette.subtext; font-size: 12px; horizontal-alignment: right; }
                                        }
                                        Rectangle { height: 1px; background: Palette.divider; }
                                        HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: root.vi ? "Bo mạch chủ:" : "Motherboard:"; color: Palette.subtext; font-size: 12px; }
                                            Text { text: root.device-info.mb-vendor + "  " + root.device-info.mb-name; color: Palette.text; font-size: 12px; font-weight: 600; horizontal-stretch: 1; horizontal-alignment: right; }
                                        }
                                    }
                                }

                                // Thẻ Đồ họa (GPU) & Màn hình (Display)
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E7F4}"; font-size: 15px; color: #4ade80; width: 18px; }
                                            Text { text: root.vi ? "Đồ họa & Màn hình" : "Graphics & Display"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        for g in root.device-info.gpus : HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: g.title; color: Palette.text; font-size: 13px; font-weight: 600; horizontal-stretch: 1; overflow: elide; }
                                            Text { text: g.sub; color: Palette.subtext; font-size: 12px; horizontal-alignment: right; }
                                        }
                                        if root.device-info.displays.length > 0 : Rectangle { height: 1px; background: Palette.divider; }
                                        for m in root.device-info.displays : HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: m.title; color: Palette.subtext; font-size: 12px; horizontal-stretch: 1; overflow: elide; }
                                            Text { text: m.sub; color: Palette.text; font-size: 12px; font-weight: 600; horizontal-alignment: right; }
                                        }
                                    }
                                }

                                // Thẻ RAM
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E964}"; font-size: 15px; color: #c084fc; width: 18px; }
                                            Text { text: "RAM"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        for r in root.device-info.rams : HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: r.title + (r.right != "" ? " · " + r.right : ""); color: Palette.text; font-size: 13px; font-weight: 600; }
                                            Text { text: r.sub; color: Palette.subtext; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: right; overflow: elide; }
                                        }
                                    }
                                }

                                // Thẻ Nền tảng & Khả năng
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E946}"; font-size: 15px; color: Palette.accent; width: 18px; }
                                            Text { text: root.vi ? "Nền tảng & Tính năng hỗ trợ" : "Platform & Capabilities"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        Text { text: (root.vi ? "Chế độ nguồn: " : "Power modes: ") + root.device-info.power-modes; color: Palette.subtext; font-size: 12px; wrap: word-wrap; }
                                        if root.device-info.capabilities != "" : Text {
                                            text: (root.vi ? "Tính năng phần cứng: " : "Hardware capabilities: ") + root.device-info.capabilities;
                                            color: Palette.text;
                                            font-size: 12px;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Cột Phải (50%): Ổ đĩa lưu trữ, Pin, Bộ điều hợp mạng
                            VerticalLayout {
                                preferred-width: 0px;
                                horizontal-stretch: 1;
                                spacing: 12px;
                                alignment: start;

                                // Thẻ Bộ nhớ lưu trữ (Storage)
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{EDA2}"; font-size: 15px; color: Palette.accent; width: 18px; }
                                            Text { text: root.vi ? "Bộ nhớ lưu trữ (Storage)" : "Storage"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        for d in root.device-info.drives : VerticalLayout {
                                            spacing: 4px;
                                            HorizontalLayout {
                                                spacing: 8px;
                                                Text { text: d.title; color: Palette.text; font-size: 13px; font-weight: 700; }
                                                Text { text: d.usage; color: Palette.subtext; font-size: 12px; horizontal-stretch: 1; horizontal-alignment: right; }
                                            }
                                            Rectangle {
                                                height: 5px;
                                                border-radius: 2.5px;
                                                background: Palette.bar-track;
                                                Rectangle {
                                                    x: 0px;
                                                    width: parent.width * (d.fraction < 0 ? 0 : (d.fraction > 1 ? 1 : d.fraction));
                                                    height: parent.height;
                                                    border-radius: 2.5px;
                                                    background: Palette.bar-fill;
                                                }
                                            }
                                            if d.model != "" : Text { text: d.model; color: Palette.subtext; font-size: 11px; }
                                        }
                                    }
                                }

                                // Thẻ Pin (Battery)
                                Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 6px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E83F}"; font-size: 15px; color: #4ade80; width: 18px; }
                                            Text { text: root.vi ? "Pin" : "Battery"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; horizontal-stretch: 1; }
                                            Text { text: (root.vi ? "Sạc: " : "Charge: ") + root.device-info.bat-charge + "  ·  " + (root.vi ? "Độ bền: " : "Health: ") + root.device-info.bat-health; color: Palette.text; font-size: 12px; font-weight: 700; }
                                        }
                                        Rectangle {
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: Palette.bar-track;
                                            Rectangle {
                                                x: 0px;
                                                width: parent.width * (root.device-info.bat-health-frac < 0 ? 0 : (root.device-info.bat-health-frac > 1 ? 1 : root.device-info.bat-health-frac));
                                                height: parent.height;
                                                border-radius: 2.5px;
                                                background: #34d399;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text {
                                                text: (root.vi ? "Dung lượng: " : "Capacity: ") + root.device-info.bat-full + " / " + root.device-info.bat-design;
                                                color: Palette.subtext;
                                                font-size: 12px;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: (root.vi ? "Chu kỳ: " : "Cycles: ") + root.device-info.bat-cycles + "  ·  " + root.device-info.bat-date;
                                                color: Palette.subtext;
                                                font-size: 12px;
                                                horizontal-alignment: right;
                                            }
                                        }
                                    }
                                }

                                // Thẻ Bộ điều hợp mạng (Network Adapters)
                                if root.device-info.nets.length > 0 : Rectangle {
                                    background: Palette.card-bg;
                                    border-radius: 10px;
                                    border-width: 1px;
                                    border-color: Palette.card-border;
                                    VerticalLayout {
                                        padding: 14px;
                                        spacing: 7px;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Icon { glyph: "\u{E701}"; font-size: 15px; color: Palette.accent; width: 18px; }
                                            Text { text: root.vi ? "Bộ điều hợp mạng" : "Network Adapters"; color: Palette.text; font-size: 14px; font-weight: 700; vertical-alignment: center; }
                                        }
                                        for n in root.device-info.nets : HorizontalLayout {
                                            spacing: 10px;
                                            Text { text: n.title; color: Palette.text; font-size: 12px; font-weight: 600; horizontal-stretch: 1; overflow: elide; }
                                            Text { text: n.sub; color: Palette.subtext; font-size: 11px; horizontal-alignment: right; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    }
                }
            }
        }
    }
}
